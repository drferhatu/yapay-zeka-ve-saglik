---
/**
 * Sayfadaki tüm kod / istem kutularına (<pre>) "Kopyala" düğmesi ekler.
 * - Markdown kod blokları, <details> içindekiler ve NotebookLM istemleri dahil.
 * - Bir kutuyu hariç tutmak için: <pre data-no-copy>
 * Düğme istemci tarafında eklendiği için arama dizinine (Pagefind) girmez.
 */
---
<script>
  const LABEL = 'Kopyala';
  const DONE = 'Kopyalandı';
  const FAIL = 'Kopyalanamadı';
  const ICON_COPY =
    '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/></svg>';
  const ICON_OK =
    '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';

  async function copyText(text: string): Promise<boolean> {
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
        return true;
      }
    } catch {
      /* eski tarayıcı / izin yok: aşağıdaki yedeğe düş */
    }
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.setAttribute('readonly', '');
    ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0';
    document.body.appendChild(ta);
    ta.select();
    let ok = false;
    try { ok = document.execCommand('copy'); } catch { ok = false; }
    ta.remove();
    return ok;
  }

  function setState(btn: HTMLButtonElement, icon: string, label: string, cls?: string) {
    btn.classList.remove('is-copied', 'is-failed');
    if (cls) btn.classList.add(cls);
    btn.innerHTML = `${icon}<span>${label}</span>`;
  }

  function enhance(pre: HTMLPreElement) {
    if (pre.dataset.copyReady || pre.hasAttribute('data-no-copy')) return;
    pre.dataset.copyReady = 'true';

    const wrap = document.createElement('div');
    wrap.className = 'code-block';
    pre.parentNode!.insertBefore(wrap, pre);
    wrap.appendChild(pre);

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.setAttribute('aria-label', 'Kodu panoya kopyala');
    btn.setAttribute('data-pagefind-ignore', '');
    setState(btn, ICON_COPY, LABEL);
    wrap.appendChild(btn);

    let timer: number | undefined;
    btn.addEventListener('click', async () => {
      const text = (pre.textContent ?? '').replace(/\n+$/, '');
      const ok = await copyText(text);
      setState(btn, ok ? ICON_OK : ICON_COPY, ok ? DONE : FAIL, ok ? 'is-copied' : 'is-failed');
      clearTimeout(timer);
      timer = window.setTimeout(() => setState(btn, ICON_COPY, LABEL), 2000);
    });
  }

  document.querySelectorAll<HTMLPreElement>('main pre').forEach(enhance);
</script>

---
interface Props { eyebrow?: string; title: string; id?: string; lede?: string; align?: 'left' | 'center'; }
const { eyebrow, title, id, lede, align = 'left' } = Astro.props;
---
<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id} class="display mt-2 text-3xl md:text-4xl text-ink">{title}</h2>
  {lede && <p class="mt-4 text-base md:text-lg leading-relaxed text-ink-2">{lede}</p>}
</div>

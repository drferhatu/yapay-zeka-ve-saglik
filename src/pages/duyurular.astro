---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { getCollection, render } from 'astro:content';
import { formatDateObj } from '@/lib/site';
import Channels from '@/components/Channels.astro';
const list = (await getCollection('announcements')).sort((a, b) =>
  Number(b.data.pinned) - Number(a.data.pinned) || b.data.date.getTime() - a.data.date.getTime());
const rendered = await Promise.all(list.map(async (a) => ({ a, C: (await render(a)).Content })));
const KIND = { bilgi: ['Bilgi', 'bg-brand-soft text-brand'], onemli: ['Önemli', 'bg-accent-soft text-accent'], sinav: ['Sınav', 'bg-[#fbeeda] text-[#8a5a10]'] } as const;
---
<BaseLayout title="Duyurular" description="Ders duyuruları: sınav tarihleri, program değişiklikleri ve hatırlatmalar.">
  <div class="wrap py-14 md:py-20">
    <SectionHeading eyebrow="Duyurular" title="Güncel bilgiler" lede="Program değişiklikleri, sınav tarihleri ve hatırlatmalar burada yayımlanır." />
  </div>
  <div class="wrap pb-16"><Channels title="Duyuruları kaçırmayın" /></div>
  <div class="wrap-narrow pb-24">
    <h2 class="display mb-6 text-2xl">Duyurular</h2>
    {rendered.length === 0 && <p class="text-ink-2">Henüz duyuru yok.</p>}
    <ol class="space-y-6">
      {rendered.map(({ a, C }) => (
        <li class="rounded-2xl border border-line bg-white p-6 shadow-soft">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class:list={['rounded-full px-2.5 py-0.5 font-semibold', KIND[a.data.kind][1]]}>{KIND[a.data.kind][0]}</span>
            {a.data.pinned && <span class="rounded-full bg-paper-2 px-2.5 py-0.5 font-semibold text-ink-2">Sabit</span>}
            <time class="text-ink-3" datetime={a.data.date.toISOString()}>{formatDateObj(a.data.date)}</time>
          </div>
          <h2 class="mt-3 font-display text-xl font-semibold text-ink">{a.data.title}</h2>
          <div class="prose-lesson mt-3 text-base"><C /></div>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>

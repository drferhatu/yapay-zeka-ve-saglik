---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Roadmap from '@/components/Roadmap.astro';
import WeekCard from '@/components/WeekCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Stat from '@/components/Stat.astro';
import { course, modules, href, getWeeksSorted, weekHref } from '@/lib/site';
import { getCollection } from 'astro:content';

const weeks = await getWeeksSorted();
const firstWeeks = weeks.slice(0, 3);
const announcements = (await getCollection('announcements'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const pillars = [
  { t: 'Kod yazan hekim', d: 'İlk haftadan Python ile klinik hesaplayıcılar yazarsınız; VKİ, eGFR, risk skorları.', icon: 'M8 9l-4 3 4 3M16 9l4 3-4 3M13 6l-2 12' },
  { t: 'Veriyle düşünen hekim', d: 'Gerçek sağlık veri setlerini yükler, temizler, görselleştirir ve istatistiksel olarak yorumlarsınız.', icon: 'M4 19h16M6 16V9M11 16V5M16 16v-6' },
  { t: 'Yapay zekâyı anlayan hekim', d: 'Görüntü modellerinden büyük dil modellerine, nasıl çalıştıklarını ve nerede yanıldıklarını öğrenirsiniz.', icon: 'M12 3a4 4 0 0 1 4 4v1a4 4 0 0 1-4 4 4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zM6 21v-1a6 6 0 0 1 12 0v1' },
  { t: 'Sorumlu kullanan hekim', d: 'KVKK, etik, regülasyon ve akademik dürüstlük çerçevesinde araçları güvenle kullanırsınız.', icon: 'M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7l8-4zM9 12l2 2 4-4' },
];
---
<BaseLayout title={`${course.title} — ${course.university} ${course.faculty}`} bare>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="grid-paper pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="wrap relative grid gap-12 py-16 md:grid-cols-[1.15fr_0.85fr] md:items-center md:py-24">
      <div>
        <p class="eyebrow">{course.university} · {course.faculty} · Seçmeli Ders</p>
        <h1 class="display mt-4 text-[2.6rem] leading-[1.02] text-ink sm:text-6xl md:text-7xl">
          Yapay Zekâ<br /><span class="text-brand">ve</span> Sağlık
        </h1>
        <p class="lede mt-6 max-w-xl">
          Kod yazabilen, veriyle düşünebilen hekimler için 28 haftalık uygulamalı bir yolculuk.
          Python'dan büyük dil modellerine, sağlık verisinden tıbbi etiğe.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={weekHref(1)} class="btn-primary">1. Haftadan başla</a>
          <a href={href('/ders-akisi')} class="btn-ghost">Ders akışını gör</a>
        </div>
        <dl class="mt-12 grid grid-cols-3 gap-6 border-t border-line pt-8 max-w-md">
          <Stat value="28" label="hafta" />
          <Stat value="8" label="modül" />
          <Stat value={String(course.credits.ects)} label="AKTS" />
        </dl>
      </div>

      <!-- Hero görseli: EKG'den olasılık eğrisine geçiş — tıp ile veri bilimini tek çizgide birleştirir -->
      <figure class="relative mx-auto w-full max-w-md md:max-w-none" aria-label="Elektrokardiyogram çizgisinin bir olasılık dağılımına dönüşmesini gösteren şematik çizim">
        <svg viewBox="0 0 520 420" class="w-full" role="img" aria-hidden="true">
          <defs>
            <linearGradient id="g1" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#e4572e" />
              <stop offset="1" stop-color="#0f4c5c" />
            </linearGradient>
            <linearGradient id="g2" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#0f4c5c" stop-opacity="0.18" />
              <stop offset="1" stop-color="#0f4c5c" stop-opacity="0" />
            </linearGradient>
          </defs>
          <rect x="24" y="24" width="472" height="372" rx="22" fill="#fff" stroke="#e3ddd2" />
          <g stroke="#eee9e0" stroke-width="1">
            {Array.from({ length: 9 }, (_, i) => <line x1={60 + i * 50} y1="60" x2={60 + i * 50} y2="330" />)}
            {Array.from({ length: 6 }, (_, i) => <line x1="60" y1={60 + i * 54} x2="460" y2={60 + i * 54} />)}
          </g>
          <!-- olasılık dağılımı alanı -->
          <path d="M260 300 C300 300 320 120 360 120 C400 120 420 300 460 300 Z" fill="url(#g2)" />
          <!-- EKG → eğri -->
          <path d="M60 220 H120 L135 200 L150 240 L165 120 L180 300 L195 220 H240 C270 220 290 300 320 300 C340 300 350 120 360 120 C370 120 380 300 400 300 C430 300 440 240 460 220"
                fill="none" stroke="url(#g1)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
          <!-- eşik çizgisi -->
          <line x1="360" y1="100" x2="360" y2="320" stroke="#0f4c5c" stroke-dasharray="4 6" stroke-width="1.5" />
          <g font-family="JetBrains Mono, monospace" font-size="11" fill="#6a838b">
            <text x="60" y="352">nabız · sistolik · HbA1c</text>
            <text x="300" y="352">p(hastalık | veri)</text>
            <text x="366" y="112">eşik</text>
          </g>
          <g font-family="Manrope, sans-serif" font-size="12" font-weight="700">
            <text x="60" y="52" fill="#e4572e">KLİNİK SİNYAL</text>
            <text x="366" y="52" fill="#0f4c5c" text-anchor="end" transform="translate(94 0)">MODEL ÇIKTISI</text>
          </g>
          <!-- ROC mini -->
          <g transform="translate(400 240)">
            <rect x="0" y="0" width="56" height="56" rx="8" fill="#faf8f4" stroke="#e3ddd2" />
            <path d="M6 50 C10 20 30 12 50 6" fill="none" stroke="#e4572e" stroke-width="2" />
            <line x1="6" y1="50" x2="50" y2="6" stroke="#cfc6b8" stroke-dasharray="2 3" />
          </g>
        </svg>
        <figcaption class="sr-only">Vital bulgu ölçümlerinden bir tahmin modelinin olasılık çıktısına ve ROC eğrisine uzanan ders yolculuğunun şeması</figcaption>
      </figure>
    </div>
  </section>

  <!-- NEDEN -->
  <section class="wrap py-20 md:py-28">
    <SectionHeading eyebrow="Neden bu ders?" title="Geleceğin hekimi veriyi okur, algoritmayı sorgular."
      lede="Tıp hızla dijitalleşiyor. Tanı koyan görüntü modelleri, hasta özetleyen dil modelleri ve risk hesaplayan algoritmalar klinik pratiğin parçası oluyor. Bu ders, bunları kullanan değil anlayan ve denetleyen hekimler yetiştirmeyi hedefler." />
    <ul class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-2">
      {pillars.map((p) => (
        <li class="flex gap-5">
          <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-brand-soft text-brand" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={p.icon} /></svg>
          </span>
          <div>
            <h3 class="font-display text-xl font-semibold text-ink">{p.t}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-ink-2">{p.d}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- MODÜLLER -->
  <section class="border-y border-line bg-paper-2/50 py-20 md:py-28">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading eyebrow="Yıl boyunca" title="Sekiz modül, iki yarıyıl, bir yolculuk"
          lede="Güz yarıyılında Python ve veriyle temel atılır; bahar yarıyılında derin öğrenme, büyük dil modelleri, ajanlar ve etik ile tamamlanır." />
        <a href={href('/ders-akisi')} class="btn-ghost">Tam ders akışı</a>
      </div>
      <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {modules.map((m, i) => (
          <li style={`--mod:var(--mod-${m.color})`}>
            <a href={href(`/ders-akisi#${m.slug}`)} class="group flex h-full flex-col rounded-2xl border border-line bg-white p-5 transition-all hover:-translate-y-0.5 hover:shadow-lift">
              <div class="flex items-center justify-between">
                <span class="font-display text-3xl font-medium text-[var(--mod)]">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-3">{m.semester === 1 ? 'Güz' : 'Bahar'} · H{m.weeks[0]}–{m.weeks.at(-1)}</span>
              </div>
              <h3 class="mt-4 font-bold leading-snug text-ink group-hover:text-brand">{m.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-2">{m.summary}</p>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ROADMAP -->
  <section class="wrap py-20 md:py-28" id="yol-haritasi">
    <SectionHeading eyebrow="Ders akışı" title="Haftadan haftaya yol haritası"
      lede="Her hafta tek bir derse karşılık gelir. Tarihler akademik takvime göre güncellenir; tatil ve erteleme durumları haftanın yanında belirtilir." />
    <div class="mt-14"><Roadmap weeks={weeks} /></div>
  </section>

  <!-- NEREDEN BAŞLA + DUYURU -->
  <section class="border-t border-line bg-ink text-paper">
    <div class="wrap grid gap-12 py-20 md:grid-cols-[1fr_1fr] md:py-24">
      <div>
        <p class="eyebrow !text-paper/60">Nereden başlamalıyım?</p>
        <h2 class="display mt-2 text-3xl md:text-4xl">Önce bir Google hesabı, sonra ilk kodunuz.</h2>
        <p class="mt-4 leading-relaxed text-paper/75">
          Kurulum yok, ücret yok. Dersin tamamı tarayıcıda çalışan Google Colab üzerinde yürür.
          1. haftada ortamı birlikte kurup ilk Python satırınızı yazacağız. Programlama deneyiminiz olmasa da sorun değil; ders sıfırdan başlar.
        </p>
        <ol class="mt-8 space-y-4">
          {firstWeeks.map((w) => (
            <li>
              <a href={weekHref(w.data.week)} class="group flex items-start gap-4 rounded-xl border border-paper/15 p-4 transition-colors hover:border-paper/40 hover:bg-paper/5">
                <span class="font-display text-2xl text-accent">{String(w.data.week).padStart(2, '0')}</span>
                <span>
                  <span class="block font-semibold group-hover:underline">{w.data.title}</span>
                  <span class="mt-1 block text-sm text-paper/65">{w.data.description}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <div class="flex items-baseline justify-between">
          <p class="eyebrow !text-paper/60">Duyurular</p>
          <a href={href('/duyurular')} class="text-sm text-paper/70 underline-offset-4 hover:underline">Tümü</a>
        </div>
        {announcements.length === 0 ? (
          <p class="mt-4 text-paper/70">Henüz duyuru yok.</p>
        ) : (
          <ul class="mt-4 space-y-3">
            {announcements.map((a) => (
              <li class="rounded-xl border border-paper/15 p-4">
                <p class="text-xs text-paper/55">{a.data.date.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
                <p class="mt-1 font-semibold">{a.data.title}</p>
              </li>
            ))}
          </ul>
        )}
        <div class="mt-10 rounded-2xl bg-paper/5 p-6">
          <p class="eyebrow !text-paper/60">Değerlendirme</p>
          <div class="mt-3 flex h-3 overflow-hidden rounded-full bg-paper/10" role="img" aria-label="Ara sınav yüzde 60, final yüzde 40">
            <span class="bg-accent" style="width:60%"></span>
            <span class="bg-brand-2" style="width:40%"></span>
          </div>
          <div class="mt-3 flex justify-between text-sm">
            <span><span class="inline-block size-2 rounded-full bg-accent mr-1.5"></span>Ara sınav %60</span>
            <span><span class="inline-block size-2 rounded-full bg-brand-2 mr-1.5"></span>Final %40</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

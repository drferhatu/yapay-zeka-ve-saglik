---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Roadmap from '@/components/Roadmap.astro';
import { modules, getWeeksSorted, href } from '@/lib/site';
const weeks = await getWeeksSorted();
---
<BaseLayout title="Ders Akışı" description="28 haftalık Yapay Zeka ve Sağlık dersinin yarıyıl ve modül bazında yol haritası.">
  <div class="wrap py-14 md:py-20">
    <SectionHeading eyebrow="Ders Akışı" title="Yılın tamamı tek bakışta"
      lede="Ders iki yarıyıl ve sekiz modülden oluşur. Güz yarıyılı Python, veri analizi, istatistik ve makine öğrenmesi temellerini; bahar yarıyılı derin öğrenme, büyük dil modelleri, ajan tabanlı araçlar ve etik konularını kapsar." />
    <nav aria-label="Modüller" class="mt-10 flex flex-wrap gap-2">
      {modules.map((m, i) => (
        <a href={`#${m.slug}`} class="rounded-full border border-line bg-white px-3 py-1.5 text-xs font-semibold text-ink-2 hover:border-ink hover:text-ink" style={`border-left: 3px solid var(--mod-${m.color})`}>{i + 1}. {m.short}</a>
      ))}
    </nav>
  </div>
  <div class="wrap pb-24">
    <!-- Modül anchor'ları Roadmap içindeki modül başlıklarına karşılık gelir -->
    {modules.map((m) => <span id={m.slug} class="block -mt-24 pt-24" aria-hidden="true"></span>)}
    <Roadmap weeks={weeks} />
    <p class="mt-16 text-sm text-ink-3">Haftalık tarihler akademik takvime göre güncellenir. Bir hafta tatile denk gelirse veya ertelenirse bu sayfada ve ilgili haftanın sayfasında belirtilir. Kartlar görünümü için <a class="link" href={href('/haftalar')}>tüm haftalar</a> sayfasına bakabilirsiniz.</p>
  </div>
</BaseLayout>
